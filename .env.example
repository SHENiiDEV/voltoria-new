APP_NAME="Voltoria AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://voltoria.co.uk

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# SQLite Database Setup
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Session & Cache Settings
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=voltoria.co.uk

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Voltoria AI Engine Configuration
VOLTORIA_AI_API_KEY=
VOLTORIA_AI_BASE_URL=https://api.deepseek.com
VOLTORIA_AI_MODEL=deepseek-v4-flash

# Corporate Details (INCHWARD LIMITED)
COMPANY_NAME="INCHWARD LIMITED"
COMPANY_NUMBER="16021412"
COMPANY_ADDRESS="Academy House, 11 Dunraven Place, Bridgend, Mid Glamorgan, United Kingdom, CF31 1JF"

# Namecheap Private Email (SMTP Settings)
MAIL_MAILER=smtp
MAIL_HOST=mail.privateemail.com
MAIL_PORT=465
MAIL_USERNAME=info@voltoria.co.uk
MAIL_PASSWORD=your_namecheap_private_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@voltoria.co.uk"
MAIL_FROM_NAME="Voltoria AI"

VITE_APP_NAME="${APP_NAME}"
